+
+  windows-build:
+    name: MSBuild Release Win32
+    runs-on: windows-latest
+    steps:
+      - name: Checkout
+        uses: actions/checkout@v5
+
+      - name: Fetch third-party deps + apply MSVC overlays
+        shell: bash
